# Boot ↔ Userspace candidate v1, minimal explicit QEMU virt additions to ARM64 defconfig.
# Exact QEMU command: -machine virt -cpu cortex-a57 -serial stdio
# -device virtio-blk-device,drive=vd0 -device virtio-net-device,...
# QEMU supplies its own DT. This config does not enable staged oneli PHYs.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_MODULES=y
CONFIG_DUMMY=m
